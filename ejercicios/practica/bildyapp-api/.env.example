PORT=3000
NODE_ENV=development

# Base de datos MongoDB
DB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/bildyapp?appName=Cluster0

# JWT (acceso y refresco)
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Storage (para subir firmas y PDFs)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET_SIGNATURES=signatures
SUPABASE_BUCKET_PDFS=pdfs

# Email con Resend (para enviar códigos de verificación)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@tudomain.com

# Slack (opcional — solo para notificaciones de errores 5XX)
# Deja vacío si no quieres usar Slack
SLACK_WEBHOOK_URL=
