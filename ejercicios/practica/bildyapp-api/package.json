    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.2",
    "resend": "^4.3.0",
    "sharp": "^0.34.1",
    "socket.io": "^4.8.0",
